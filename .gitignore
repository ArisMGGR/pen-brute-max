# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class

# --- Markov model cache (generated next to the corpus by markov.py) ---
*.markov-*.json
*.markov-*.pkl
*.pkl

# --- Wordlists / large corpora (not redistributed; download separately) ---
rockyou.txt
*.wordlist

# --- Virtual environments ---
.venv/
venv/
env/

# --- Environment / secrets (defensive) ---
.env
.env.*

# --- Test / coverage / packaging output ---
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/
*.log
*.db
*.sqlite
*.sqlite3

# --- IDE / editor / OS cruft ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Local audit reports (not published) ---
tests/FINDINGS.md
tests/LOG.md
tests/PASSES.md
tests/VERIFY.md
